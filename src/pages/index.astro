---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import ReservationForm from '../components/ReservationForm';
import Location from '../components/Location.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

const { reservations, social } = siteConfig;
---

<BaseLayout>
  <main>
    <Hero />
    <Menu />
    <About />
    <Gallery />
    <section class="py-24 px-6" id="reservas">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-ink mb-4 text-center" data-reveal>
          Reservas
        </h2>
        <p class="text-muted text-center mb-12">
          Mesa para {reservations.minParty} a {reservations.maxParty} personas. Reserva con hasta {reservations.advanceDays} días de antelación.
        </p>
        {reservations.enabled && (
          <ReservationForm
            client:visible
            minParty={reservations.minParty}
            maxParty={reservations.maxParty}
            whatsappFallback={reservations.whatsappFallback}
            emailFallback={reservations.emailFallback}
            whatsappUrl={social.whatsapp}
          />
        )}
      </div>
    </section>
    <Location />
    <SocialLinks />
  </main>
  <Footer />
</BaseLayout>
