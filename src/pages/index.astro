---
// src/pages/index.astro
// Composition: sea Hero → Menu (featured dishes + carta) → About/story →
// light asymmetric Gallery → teal demo reservation panel → Location/hours/map
// → Footer. Every image is credited as archive; no dish photo claims to be
// Marea's own; no chef/history/story claims; no fake ratings or confirmations.
// Nothing is hidden pending an animation.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import ReservationForm from '../components/ReservationForm.tsx';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
// Single import site for the Story (About) + Gallery section styles.
import '../styles/sections-story-gallery.css';
const { reservations } = siteConfig;
---
<BaseLayout>
  <SiteHeader />

  <main>
    <Hero />
    <About />
    <Menu />
    <Gallery />

    <!-- Light editorial demo reservation close: copy + disclosure in one
         column, the demo form in the other (desktop), stacked on mobile.
         No availability claim, no booking confirmation. -->
    <section
      id="reservas"
      data-motion="section"
      class="bg-ground text-ink px-5 sm:px-8 py-20 md:py-28"
    >
      <div class="mx-auto max-w-[1400px] grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5 md:col-span-6">
          <h2
            class="font-display font-bold text-ink leading-[0.95] text-[clamp(2.5rem,6vw,4.5rem)]"
          >
            Reservas
          </h2>
          <p class="mt-4 text-lg text-muted max-w-[40ch]">
            Mesa para {reservations.minParty} a {reservations.maxParty} personas. Reserva con hasta {reservations.advanceDays} días de antelación.
          </p>
          <p class="mt-4 text-sm text-muted max-w-[42ch]">
            * Marea es un restaurante ficticio. Los datos de contacto y horarios son de ejemplo.
          </p>
          <p class="mt-4 text-sm text-muted max-w-[42ch]" data-demo-disclosure role="note">
            Demostración: el formulario solo prepara una solicitud en tu navegador. No se envía ningún dato, no se confirma ninguna reserva y no garantiza disponibilidad.
          </p>
        </div>
        <div class="lg:col-span-7 md:col-span-6">
          <ReservationForm
            minParty={reservations.minParty}
            maxParty={reservations.maxParty}
            whatsappFallback={reservations.whatsappFallback}
            emailFallback={reservations.emailFallback}
            whatsappUrl={siteConfig.social.whatsapp}
          />
        </div>
      </div>
    </section>

    <Location />
  </main>

  <Footer />
</BaseLayout>
