---
// src/pages/index.astro
// Direction: page-is-the-object — the page reads like a printed market ledger
// ("Cuaderno del mercado"). Light-first: mineral paper ground, petrol ink,
// sea-glass accent. Desktop: archive photograph beside a reading column.
// Mobile: photograph first, then the reading column. Every image is credited
// as archive; no dish photo claims to be Marea's own; no chef/history/story
// claims; no fake ratings or confirmations.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import { siteConfig } from '../config/site';
const { hours, location, reservations } = siteConfig;

const mailtoSubject = encodeURIComponent('Solicitud de reserva — Marea Bistro (demostración)');
const mailtoBody = encodeURIComponent(
  'Hola, me gustaría solicitar una reserva en Marea Bistro.\n\n' +
  'Aviso de demostración: este sitio es una plantilla de ejemplo. Marea es un restaurante ficticio. ' +
  'Esta página solo prepara el correo: no lo envía automáticamente ni confirma una reserva. Tú decides si enviar este mensaje.\n\n' +
  'Detalles por definir: fecha, hora y número de comensales.'
);

import creditsData from '../../public/images/credits.json';
const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));
function creditFor(file: string) {
  const c = creditByFile[file];
  if (!c) return null;
  return {
    title: c.title,
    creator: c.creator,
    license: c.license,
    licenseUrl: c.licenseUrl,
    page: c.page,
    via: c.via,
  };
}

const gallery = siteConfig.images.gallery.map((src) => {
  const c = creditFor(src);
  return {
    src,
    alt: `Imagen de archivo: ${c?.title ?? src.split('/').pop()}. No muestra el local ni los platos de Marea.`,
    w: 1920,
    h: 1280,
    credit: c,
  };
});
---
<BaseLayout>
  <SiteHeader />

  <div class="lg:grid lg:grid-cols-[48fr_52fr] lg:gap-8 lg:items-start">
    <!-- Left: archive photograph (hero), sticky on desktop -->
    <Hero />

    <!-- Right: reading column — the market ledger -->
    <div class="bg-ground px-5 pt-6 md:pt-16 lg:pt-0 lg:sticky lg:top-5">
      <section id="hero" class="pb-10 md:pb-24" data-reveal>
        <h1 data-hero-heading class="font-display font-bold text-ink leading-[0.95] tracking-tighter" data-reveal>Marea</h1>
        <hr data-hero-accent-line aria-hidden="true" class="taste-skill-ignore" />
        <p data-hero-subhead class="text-ink mt-4 leading-relaxed" data-reveal>
          Bistró mediterráneo · Valencia
        </p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-8" data-reveal>
          <a
            href="#reservas"
            class="btn-square"
          >
            Reservar mesa
          </a>
          <a
            href="#carta"
            class="btn-square-outline"
          >
            Ver la carta
          </a>
        </div>
        <p data-demo-disclosure role="note" class="text-base text-ink mt-6 leading-relaxed" data-reveal>
          <strong>Demostración:</strong> Marea es un restaurante ficticio. Los platos, precios, horarios y datos de contacto son contenido de ejemplo y no describen un negocio real.
        </p>
      </section>

      <Menu />

      <section id="galeria" class="px-5 pt-16 md:pt-20" data-reveal>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4" data-reveal>Galería de archivo</h2>
        <p class="text-ink text-base mb-10" data-reveal>Imágenes de archivo del entorno valenciano; no muestran el local ni los platos de Marea.</p>
        <!-- Bento asimétrico intencional: exterior a todo ancho en escritorio (lg:col-span-2, aspect-[4/3]);
             Albufera + alcachofas apiladas en móvil y lado a lado en escritorio, segunda columna con offset deliberado (mt-8 lg:mt-8). -->
        <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8" data-reveal>
          {gallery.map((g) => {
            const isWide = g.src === '/images/mercado-central-exterior.jpg';
            const isSecondColumn = g.src === '/images/valencia-market-artichokes.jpg';
            return (
              <figure tabindex={0} class={['group relative overflow-hidden rounded-md bg-ground', isWide ? 'lg:col-span-2' : '', isSecondColumn ? 'mt-8 lg:mt-8' : ''].filter(Boolean).join(' ')} data-reveal>
                <img
                  src={g.src}
                  alt={g.alt}
                  width={g.w}
                  height={g.h}
                  loading="lazy"
                  class={['gallery-img block w-full object-cover object-center group-hover:scale-[1.03]', isWide ? 'aspect-[4/3]' : ''].filter(Boolean).join(' ')}
                />
                <figcaption class="gallery-figcaption absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-ink/90 to-transparent text-ground text-sm leading-relaxed opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-visible:opacity-100 group-focus-visible:pointer-events-auto taste-skill-ignore:gradient" style="transition: opacity var(--duration-base) var(--ease-standard)">
                  <p class="text-sm leading-relaxed">
                    {g.credit?.title}. Foto:{' '}
                    <span class="font-semibold">{g.credit?.creator}</span>,
                    {g.credit?.license}, vía {g.credit?.via}.
                  </p>
                  <p class="mt-1">
                    <a
                      href={g.credit?.page ?? '#'}
                      target="_blank"
                      rel="noopener"
                      class="gallery-credit-link underline underline-offset-2"
                      style="color: inherit; text-underline-offset: 2px"
                    >
                      fuente
                    </a>{' · '}
                    <a
                      href={g.credit?.licenseUrl ?? '#'}
                      target="_blank"
                      rel="noopener"
                      class="gallery-credit-link underline underline-offset-2"
                      style="color: inherit; text-underline-offset: 2px"
                    >
                      licencia
                    </a>.
                  </p>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>

      <section id="reservas" class="px-5 pt-16 md:pt-20 pb-16" data-reveal>
        <div class="max-w-[46ch]">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-6" data-reveal>Reservas</h2>
          <p class="text-ink text-base mb-4" data-reveal>
            Mesa para {reservations.minParty} a {reservations.maxParty} personas. Reserva con hasta {reservations.advanceDays} días de antelación.
          </p>
          <p id="ubicacion" class="text-ink text-base mb-10" data-reveal>
            {location.address}, {location.city}. Tel. {location.phone}.
          </p>

          <h3 class="font-display text-xl font-bold text-ink mb-4" data-reveal>Horario</h3>
          <ul class="text-ink text-base space-y-2" data-reveal>
            {hours.map((h) => (
              <li class="flex justify-between" data-reveal>
                <span>{h.day}</span>
                <span>{h.closed ? 'Cerrado' : `${h.open}${h.open2 ? ` / ${h.open2}` : ''} – ${h.close}${h.close2 ? ` / ${h.close2}` : ''}`}</span>
              </li>
            ))}
          </ul>

          <a
            href={`mailto:${encodeURIComponent(reservations.emailFallback)}?subject=${mailtoSubject}&body=${mailtoBody}`}
            class="btn-square mt-10 block text-center w-fit"
            data-reveal
          >
            Solicitar reserva
          </a>
          <p class="text-sm text-ink mt-8" data-reveal>
            Datos de ejemplo (Marea es un restaurante ficticio de demostración).
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
