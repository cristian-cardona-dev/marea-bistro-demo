---
// src/pages/index.astro
// Composition: a vertical editorial sequence — full-bleed food hero →
// asymmetric typographic menu → archive gallery (one supporting image, shown
// deliberately and balanced) → dark booking close. Every image is credited as
// archive; no dish photo claims to be Marea's own; no chef/history/story
// claims; no fake ratings or confirmations. Nothing is hidden pending an
// animation.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Menu from '../components/Menu.astro';
import { siteConfig } from '../config/site';
const { hours, location, reservations, content } = siteConfig;

const mailtoSubject = encodeURIComponent('Solicitud de reserva — Marea Bistro (demostración)');
const mailtoBody = encodeURIComponent(
  'Hola, me gustaría solicitar una reserva en Marea Bistro.\n\n' +
  'Aviso de demostración: este sitio es una plantilla de ejemplo. Marea es un restaurante ficticio. ' +
  'Esta página solo prepara el correo: no lo envía automáticamente ni confirma una reserva. Tú decides si enviar este mensaje.\n\n' +
  'Detalles por definir: fecha, hora y número de comensales.'
);
const mailtoHref = `mailto:${encodeURIComponent(reservations.emailFallback)}?subject=${mailtoSubject}&body=${mailtoBody}`;

import creditsData from '../../public/images/credits.json';
const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));
function creditFor(file: string) {
  const c = creditByFile[file];
  if (!c) return null;
  return {
    title: c.title,
    creator: c.creator,
    license: c.license,
    licenseUrl: c.licenseUrl,
    page: c.page,
    via: c.via,
  };
}

// Archive gallery, in siteConfig order. Alt + caption state plainly that these
// are archive photographs of the Mediterranean/Valencian context, not Marea.
const gallery = siteConfig.images.gallery.map((src) => {
  const c = creditFor(src);
  return {
    src,
    alt: `Imagen de archivo: ${c?.title ?? src.split('/').pop()}. No muestra el local ni los platos de Marea.`,
    credit: c,
  };
});
---
<BaseLayout>
  <SiteHeader />

  <main>
    <Hero />
    <Menu />

    <!-- Archive gallery — one supporting image, shown deliberately and balanced -->
    <section id="galeria" data-motion="section" class="bg-ground-alt px-5 sm:px-8 py-20 md:py-28">
      <div class="mx-auto max-w-[1400px]">
        <div class="max-w-[52ch]">
          <h2 class="font-display font-bold text-ink leading-[0.95] text-[clamp(2.5rem,6vw,4.5rem)]">
            Archivo fotográfico
          </h2>
          <p class="mt-4 text-lg text-ink/80">
            Imágenes de archivo del entorno valenciano y mediterráneo. No muestran el local ni los platos de Marea.
          </p>
        </div>

        <div class="mt-12 flex flex-col gap-10">
          {gallery.map((g) => (
            <figure class="m-0">
              <div class="overflow-hidden bg-ink/5 aspect-[16/9]">
                <img
                  src={g.src}
                  alt={g.alt}
                  width="1920"
                  height="1280"
                  loading="lazy"
                  class="gallery-img h-full w-full object-cover object-center"
                />
              </div>
              <figcaption class="mt-3 text-sm leading-relaxed text-ink/70">
                <span class="text-ink font-medium">{g.credit?.title ?? 'Imagen de archivo'}</span>. Foto:{' '}
                <span class="font-medium">{g.credit?.creator}</span>{g.credit?.license ? `, ${g.credit.license}` : ''}, vía {g.credit?.via}.{' '}
                {g.credit?.page && (
                  <a
                    href={g.credit.page}
                    target="_blank"
                    rel="noopener"
                    class="gallery-credit-link underline underline-offset-2"
                  >
                    fuente
                  </a>
                )}
                {g.credit?.page && g.credit?.licenseUrl && ' · '}
                {g.credit?.licenseUrl && (
                  <a
                    href={g.credit.licenseUrl}
                    target="_blank"
                    rel="noopener"
                    class="gallery-credit-link underline underline-offset-2"
                  >
                    licencia
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Booking close — dark cinematic panel -->
    <section id="reservas" data-motion="section" class="bg-ink text-ground px-5 sm:px-8 py-20 md:py-28">
      <div class="mx-auto max-w-[1400px] grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <h2 class="font-display font-bold text-ground leading-[0.95] text-[clamp(2.5rem,6vw,4.5rem)]">
            Reservas
          </h2>
          <p class="mt-4 text-lg text-ground/85 max-w-[40ch]">
            Mesa para {reservations.minParty} a {reservations.maxParty} personas. Reserva con hasta {reservations.advanceDays} días de antelación.
          </p>
          <p id="ubicacion" class="mt-4 text-ground/85">
            {location.address}, {location.city}. Tel. {location.phone}.
          </p>
          <a href={mailtoHref} class="btn-square mt-8">
            Solicitar reserva
          </a>
          <p class="mt-6 text-sm text-ground/60">
            Datos de ejemplo (Marea es un restaurante ficticio de demostración).
          </p>
        </div>

        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="font-display font-bold text-ground text-2xl">Horario</h3>
          <ul class="mt-4 list-none p-0 m-0 divide-y divide-ground/15">
            {hours.map((h) => (
              <li class="flex justify-between gap-6 py-3 text-ground/90">
                <span>{h.day}</span>
                <span class="text-ground/70 tabular-nums text-right">
                  {h.closed ? 'Cerrado' : `${h.open}${h.open2 ? ` / ${h.open2}` : ''} – ${h.close}${h.close2 ? ` / ${h.close2}` : ''}`}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-ground/60 border-t border-ground/10 px-5 sm:px-8 py-8">
    <div class="mx-auto max-w-[1400px] flex flex-col sm:flex-row justify-between gap-3 text-sm">
      <p>{content.footerText}</p>
      <p>Imágenes ilustrativas de archivo (Pexels). No representan el local ni los platos de Marea.</p>
    </div>
  </footer>
</BaseLayout>