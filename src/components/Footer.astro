---
// src/components/Footer.astro
// Canonical footer for the active page. Truthful, provider-neutral credit note:
// sources/licenses are listed per image in their captions (see Gallery).
import { siteConfig } from '../config/site';

const { content } = siteConfig;
---

<footer class="bg-ink text-ground/60 border-t border-ground/10 px-5 sm:px-8 py-8" id="footer">
  <div class="mx-auto max-w-[1400px] flex flex-col sm:flex-row justify-between gap-3 text-sm">
    <p>{content.footerText}</p>
    <p>Galería y carta muestran fuente y licencia en sus pies de foto; el resto son imágenes ilustrativas de archivo.</p>
  </div>
</footer>
