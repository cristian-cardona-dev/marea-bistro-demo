---
// src/components/Hero.astro
// Full-bleed editorial hero: the photograph is the stage, the wordmark,
// descriptor and primary action sit over it on a functional legibility scrim.
// The image is bound to siteConfig.images.hero (never a hard-coded filename).
// Attribution comes from credits.json; alt and caption stay generic and truthful
// (illustrative archive photography, not Marea's venue or dishes).
// No script hides anything, and nothing starts at opacity 0.
import { siteConfig } from '../config/site';
import creditsData from '../../public/images/credits.json';

const { images, brand } = siteConfig;

const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));

const heroFile = images.hero;
const heroCredit = (creditByFile[heroFile] ?? null) as Record<string, string | null> | null;

const creditTitle = heroCredit?.title ?? '';
const creditCreator = heroCredit?.creator ?? '';
const creditLicense = heroCredit?.license ?? '';
const creditPage = heroCredit?.page ?? null;
const creditLicenseUrl = heroCredit?.licenseUrl ?? null;

const heroWidth = Number(heroCredit?.width ?? 1920) || 1920;
const heroHeight = Number(heroCredit?.height ?? 1280) || 1280;
// Generic, honest description regardless of which archive file the config points at.
const archiveAlt = creditTitle
  ? `Fotografía ilustrativa de archivo: ${creditTitle}. No representa el local ni los platos de Marea.`
  : 'Fotografía ilustrativa de archivo. No representa el local ni los platos de Marea.';
---
<section id="hero" data-motion="section" class="relative bg-ink text-ground">
  <figure data-motion="hero" class="relative m-0 overflow-hidden">
    <img
      id="hero-img"
      src={heroFile}
      alt={archiveAlt}
      width={heroWidth}
      height={heroHeight}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block w-full h-[52svh] min-h-[320px] lg:h-[74svh] lg:min-h-[520px] object-cover object-center"
    />

    <!-- Functional legibility scrim behind the overlaid wordmark (not decorative). -->
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink/92 via-ink/45 to-transparent taste-skill-ignore:gradient"
      aria-hidden="true"
    ></div>

    <figcaption class="absolute inset-x-0 bottom-0">
      <div class="mx-auto max-w-[1400px] px-5 sm:px-8 pb-8 sm:pb-10">
        <p class="text-ground/90 text-base sm:text-lg">{brand.tagline}</p>
        <h1
          data-hero-heading
          class="font-display font-bold text-ground leading-[0.9] tracking-tight mt-1 text-[clamp(3.5rem,13vw,9rem)]"
        >
          {brand.name}
        </h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-6">
          <a href="#reservas" class="btn-square">Reservar mesa</a>
          <a
            href="#carta"
            class="inline-flex items-center min-h-[44px] text-ground font-semibold underline underline-offset-4 decoration-ground/50 hover:decoration-ground"
          >
            Ver la carta
          </a>
        </div>
      </div>
    </figcaption>
  </figure>

  <!-- Honest archive attribution + demo disclosure on a plain, legible surface. -->
  <div class="bg-ground text-ink">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-4 flex flex-col gap-2">
      <p id="hero-caption" data-hero-credit class="text-xs sm:text-sm text-ink/70">
        Fotografía ilustrativa de archivo{creditTitle ? `: ${creditTitle}` : ''}.{' '}
        {creditCreator && <>{' '}Foto: <span id="hero-scene-creator">{creditCreator}</span>{creditLicense ? `, ${creditLicense}` : ''}.</>}
        {(creditPage || creditLicenseUrl) && ' '}
        {creditPage && (
          <a id="hero-scene-link-page" href={creditPage} target="_blank" rel="noopener" class="underline underline-offset-2">
            fuente
          </a>
        )}
        {creditPage && creditLicenseUrl && ' · '}
        {creditLicenseUrl && (
          <a id="hero-scene-link-license" href={creditLicenseUrl} target="_blank" rel="noopener" class="underline underline-offset-2">
            licencia
          </a>
        )}
      </p>
      <p data-demo-disclosure role="note" class="text-sm sm:text-base text-ink leading-relaxed">
        <strong>Demostración:</strong> Marea es un restaurante ficticio. Los platos, precios, horarios y datos de contacto son contenido de ejemplo y no describen un negocio real.
      </p>
    </div>
  </div>
</section>