---
// src/components/Hero.astro
// Static sticky archive hero: one Mercado Central interior photograph with
// linked source/license/archive credit. Desktop: sticky beside the reading
// column (>=1024px). Mobile: 32svh crop at top. Always visible, no JS.
import { siteConfig } from '../config/site';
import creditsData from '../../public/images/credits.json';

const { images } = siteConfig;

const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));

function creditFor(file: string) {
  const c = creditByFile[file];
  if (!c) return null;
  return {
    title: c.title,
    creator: c.creator,
    license: c.license,
    licenseUrl: c.licenseUrl,
    page: c.page,
    via: c.via,
  };
}

const heroFile = images.hero; // /images/gallery-market.jpg
const heroCredit = creditFor(heroFile);
---
<figure
  id="hero-stage"
  class="relative h-[32svh] lg:h-[calc(100svh-3rem)] lg:sticky lg:top-12 lg:self-start w-full overflow-hidden bg-ground/50"
>
  <img
    id="hero-img"
    src={heroFile}
    alt="Imagen de archivo: Mercado Central de Valencia, interior del mercado. No es el local de Marea."
    class="w-full h-full object-cover object-center"
    width="1920"
    height="1240"
    loading="eager"
    fetchpriority="high"
  />

  <figcaption
    data-hero-credit
    data-hero-credit-band
    class="absolute inset-x-0 bottom-0 px-5 pt-3 pb-4"
    style="background-color: #0A1628; color: #F8F5F0"
  >
    <div class="text-sm leading-relaxed">
      <p id="hero-scene-context">Imagen de archivo: Mercado Central, Valencia. Interior del mercado.</p>
      <p id="hero-scene-credit" class="mt-1">
        <span id="hero-scene-title">{heroCredit?.title ?? ''}</span>. Foto:
        <span id="hero-scene-creator">{heroCredit?.creator ?? ''}</span>,
        <span id="hero-scene-license">{heroCredit?.license ?? ''}</span>, vía{' '}
        <span id="hero-scene-via">{heroCredit?.via ?? ''}</span>.
        {heroCredit?.page ? (
          <a
            id="hero-scene-link-page"
            href={heroCredit.page}
            target="_blank"
            rel="noopener"
            class="underline"
            style="color: inherit; text-underline-offset: 2px"
          >
            fuente
          </a>
        ) : (
          <span id="hero-scene-link-page">fuente</span>
        )}{' · '}
        {heroCredit?.licenseUrl ? (
          <a
            id="hero-scene-link-license"
            href={heroCredit.licenseUrl}
            target="_blank"
            rel="noopener"
            class="underline"
            style="color: inherit; text-underline-offset: 2px"
          >
            licencia
          </a>
        ) : (
          <span id="hero-scene-link-license">licencia</span>
        )}.
      </p>
      <p id="hero-scene-archive" class="mt-1">
        No es el local de Marea: es una fotografía de archivo del mercado.
      </p>
    </div>
  </figcaption>
</figure>
