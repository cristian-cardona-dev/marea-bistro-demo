---
// src/components/Hero.astro
// Hero stage: Mercado Central interior archive photograph with a scroll-linked
// caption band (desktop only). Progressive enhancement: the band is fully
// visible without JS; JS only applies opacity/translateY tied to scrollY.
import { siteConfig } from '../config/site';
import creditsData from '../../public/images/credits.json';

const { images } = siteConfig;

const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));

function creditFor(file: string) {
  const c = creditByFile[file];
  if (!c) return null;
  return {
    title: c.title,
    creator: c.creator,
    license: c.license,
    licenseUrl: c.licenseUrl,
    page: c.page,
    via: c.via,
  };
}

const heroFile = images.hero; // /images/gallery-market.jpg
const heroCredit = creditFor(heroFile);
---
<figure
  id="hero-stage"
  class="relative h-[32svh] lg:h-[calc(100svh-3rem)] lg:sticky lg:top-12 lg:self-start w-full overflow-hidden bg-ground/50"
>
  <img
    id="hero-img"
    src={heroFile}
    alt="Imagen de archivo: Mercado Central de Valencia, interior del mercado. No es el local de Marea."
    class="w-full h-full object-cover object-center"
    width="1920"
    height="1240"
    loading="eager"
    fetchpriority="high"
  />

  <figcaption
    id="hero-caption"
    data-hero-credit
    data-hero-credit-band
    data-hero-scroll-band
    class="absolute inset-x-0 bottom-0 px-5 pt-3 pb-4"
  >
    <div class="text-sm leading-relaxed">
      <p
        id="hero-scene-context"
        data-hero-band-line
        style="--band-stagger: 0ms"
      >
        Imagen de archivo: Mercado Central, Valencia. Interior del mercado.
      </p>
      <p
        id="hero-scene-credit"
        data-hero-band-line
        style="--band-stagger: 80ms"
      >
        <span id="hero-scene-title">{heroCredit?.title ?? ''}</span>. Foto:{' '}
        <span id="hero-scene-creator">{heroCredit?.creator ?? ''}</span>,
        <span id="hero-scene-license">{heroCredit?.license ?? ''}</span>, vía{' '}
        <span id="hero-scene-via">{heroCredit?.via ?? ''}</span>.
        {heroCredit?.page ? (
          <a
            id="hero-scene-link-page"
            href={heroCredit.page}
            target="_blank"
            rel="noopener"
            class="underline"
            style="color: inherit; text-underline-offset: 2px"
          >
            fuente
          </a>
        ) : (
          <span id="hero-scene-link-page">fuente</span>
        )}{' · '}
        {heroCredit?.licenseUrl ? (
          <a
            id="hero-scene-link-license"
            href={heroCredit.licenseUrl}
            target="_blank"
            rel="noopener"
            class="underline"
            style="color: inherit; text-underline-offset: 2px"
          >
            licencia
          </a>
        ) : (
          <span id="hero-scene-link-license">licencia</span>
        )}.
      </p>
      <p
        id="hero-scene-archive"
        data-hero-band-line
        style="--band-stagger: 160ms"
      >
        No es el local de Marea: es una fotografía de archivo del mercado.
      </p>
    </div>
  </figcaption>
</figure>

<script>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 1024px)').matches;
    const band = document.querySelector<HTMLElement>('[data-hero-scroll-band]');
    if (!band || reduceMotion || !desktop) return;

    const lines = Array.from(band.querySelectorAll<HTMLElement>('[data-hero-band-line]'));

    // Progressive enhancement: JS can run, so hide the band and reveal it
    // scroll-linked (0-100vh -> opacity/translateY). Without JS the band stays
    // static and fully visible (no rule hides it).
    band.style.opacity = '0';
    band.style.transform = 'translateY(16px)';
    band.style.transition = 'none'; // driven by scroll

    lines.forEach((line, i) => {
      line.style.opacity = '0';
      line.style.transform = 'translateY(12px)';
      line.style.transition = 'opacity 400ms ease, transform 400ms ease';
      line.style.transitionDelay = (i * 80) + 'ms';
    });

    function update() {
      const progress = Math.min(
        Math.max(window.scrollY / Math.max(window.innerHeight, 1), 0),
        1
      );
      band!.style.opacity = String(progress);
      band!.style.transform =
        'translateY(' + 16 * (1 - progress) + 'px)';
      if (progress > 0) {
        lines.forEach((line) => {
          line.style.opacity = '1';
          line.style.transform = 'none';
        });
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
