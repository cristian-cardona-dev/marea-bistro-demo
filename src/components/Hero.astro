---
// src/components/Hero.astro
// Full-bleed editorial hero: the photograph is the stage, the wordmark,
// descriptor and primary action sit over it on a functional legibility scrim.
// Hero image is a direct astro:assets import (not siteConfig.images), so it stays
// illustrative and is never presented as Marea's real dining room.
// Attribution comes from credits.json; alt and caption stay generic and truthful
// (illustrative archive photography, not Marea's venue or dishes).
// No script hides anything, and nothing starts at opacity 0.
import { siteConfig } from '../config/site';
import { getImage } from 'astro:assets';
import heroDesktop from '../assets/user-supplied/hero-desktop-original.png';
import heroMobile from '../assets/user-supplied/hero-mobile-original.png';
import heroOliveOverlay from '../assets/user-supplied/hero-olive-overlay.png';
import creditsData from '../../public/images/credits.json';

const { images, brand } = siteConfig;

const credits = creditsData as unknown as Array<Record<string, string | null>>;
const creditByFile = Object.fromEntries(credits.map((c) => [c.file, c]));

const heroFile = heroDesktop;
const heroWidth = heroDesktop.width;
const heroHeight = heroDesktop.height;
// User-supplied hero image: a Mediterranean terrace by the sea at dusk with a
// table set; the mobile asset is a vertical crop of the same scene. Illustrative
// archive-style photography, not Marea's real dining room or dishes.
const archiveAlt =
  'Terraza mediterránea frente al mar al atardecer, con mesa puesta. La versión móvil es un recorte vertical de la misma escena. Fotografía ilustrativa: no representa el local, la vajilla ni los platos de Marea.';

// Full-bleed stage: every candidate is one viewport wide, mobile and desktop.
// getImage() is Astro's own local-image pipeline (same astro:assets pattern the
// rest of the site uses), so the art-directed <source> elements carry real
// multi-width candidates. The result is read defensively (string or per-format
// map) and falls back to the original single candidate, so the honest 100vw
// metadata holds either way.
const heroWidths = [480, 768, 1080, 1440, 1920];
const heroSizes = '100vw';
const heroOverlayWidths = [1024, 1440, 1920];

type GeneratedImage = { src: string; srcset: string };

function readSrcset(value: unknown): string | null {
  if (!value) return null;
  if (typeof value === 'string') return value.trim() || null;
  if (typeof value === 'object') {
    const first = Object.values(value as Record<string, unknown>).find(
      (entry) => typeof entry === 'string' && (entry as string).length > 0,
    );
    return typeof first === 'string' ? first : null;
  }
  return null;
}

async function heroGenerated(
  image: typeof heroDesktop,
  widths: number[],
  fallback: string,
): Promise<GeneratedImage> {
  try {
    const generated = await getImage({ src: image, widths, sizes: heroSizes, format: 'webp' });
    // Astro's getImage() returns `srcSet` (camelCase) with an `.attribute`
    // string; fall back to legacy lowercase `srcset` then `src`.
    const built = readSrcset(
  generated?.srcSet?.attribute ?? (generated as any)?.srcset ?? generated?.src,
);
    const src =
      typeof generated?.src === 'string' && generated.src.length > 0 ? generated.src : fallback;
    const srcset = built ?? src;
    return { src, srcset };
  } catch {
    // Keep the original candidate rather than breaking the hero.
    return { src: fallback, srcset: fallback };
  }
}

const heroDesktopGenerated = await heroGenerated(heroDesktop, heroWidths, heroDesktop.src);
const heroMobileGenerated = await heroGenerated(heroMobile, heroWidths, heroMobile.src);
// Olive overlay: RGBA PNG (1774x887), geometric pair of hero-desktop.png.
// Desktop-only parallax layer; hidden on mobile. Astro optimizes via getImage().
const heroOliveOverlayGenerated = await heroGenerated(
  heroOliveOverlay,
  heroOverlayWidths,
  heroOliveOverlay.src,
);
---
<section id="hero" data-motion="section" class="relative bg-ink text-ground -mt-[68px]">
  <figure data-motion="hero" class="relative m-0 overflow-hidden">
    <picture>
  <source media="(min-width: 640px)" srcset={heroDesktopGenerated.srcset} type="image/webp" />
  <source media="(max-width: 639px)" srcset={heroMobileGenerated.srcset} type="image/webp" />
  <img
      id="hero-img"
      src={heroDesktopGenerated.src}
      srcset={heroDesktopGenerated.srcset}
      sizes={heroSizes}
      alt={archiveAlt}
      width={heroWidth}
      height={heroHeight}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block w-full h-[100svh] object-cover object-center"
  />
</picture>

    <!-- Olive foliage overlay: RGBA parallax layer (desktop only, 2.5D depth).
         Moves at a different rate than the base image to create depth.
         Reduced opacity prevents literal duplication of foliage.
         Hidden on mobile; Astro optimizes via srcset. -->
    <img
      class="hero-overlay hidden lg:block absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
      src={heroOliveOverlayGenerated.src}
      srcset={heroOliveOverlayGenerated.srcset}
      sizes={heroSizes}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width={heroOliveOverlay.width}
      height={heroOliveOverlay.height}
      style="opacity: 0.7;"
    />


    <!-- Functional legibility scrim behind the overlaid wordmark (not decorative).
         Opacity increases on scroll for deeper immersion. -->
    <div
      data-hero-scrim
      class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-ink/92 via-ink/45 to-transparent taste-skill-ignore:gradient"
      aria-hidden="true"
      style="opacity: 0.6;"
    ></div>

    <!-- Top scrim: ensures nav text legibility over the hero image. -->
    <div
      class="absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-ink/60 to-transparent taste-skill-ignore:gradient"
      aria-hidden="true"
    ></div>

    <figcaption data-hero-text class="absolute inset-x-0 bottom-0">
      <div class="mx-auto max-w-[1400px] px-5 sm:px-8 pb-8 sm:pb-10">
        <p class="text-ground/90 text-base sm:text-lg">{brand.tagline}</p>
        <h1
          data-hero-heading
          class="font-display font-bold text-ground leading-[0.9] tracking-tight mt-1 text-[clamp(3.5rem,13vw,9rem)]"
        >
          {brand.name}
        </h1>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-6">
          <a href="#reservas" class="btn-square">Reservar mesa</a>
          <a
            href="#carta"
            class="inline-flex items-center min-h-[44px] text-ground font-semibold underline underline-offset-4 decoration-ground/50 hover:decoration-ground"
          >
            Ver la carta
          </a>
        </div>
      </div>
    </figcaption>
  </figure>

  <!-- Honest archive attribution + demo disclosure on a plain, legible surface. -->
  <div class="bg-ground text-ink">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8 py-4 flex flex-col gap-2">
      <p id="hero-caption" data-hero-credit class="text-xs sm:text-sm text-ink/70">
        Imagen suministrada para esta demostración.
      </p>
      <p data-demo-disclosure role="note" class="text-sm sm:text-base text-ink leading-relaxed">
        <strong>Demostración:</strong> Marea es un restaurante ficticio. Los platos, precios, horarios y datos de contacto son contenido de ejemplo y no describen un negocio real.
      </p>
    </div>
  </div>
</section>