---
// src/components/About.astro
import { siteConfig } from '../config/site';

const { brand, content } = siteConfig;
---

<section class="py-24 px-6 bg-ground-alt/5" id="sobre-nosotros">
  <div class="max-w-5xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div data-reveal>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-ink mb-6">
          Sobre {brand.name}
        </h2>
        <p class="text-muted leading-relaxed mb-6">
          {content.aboutText}
        </p>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <p class="text-muted uppercase tracking-wider text-xs mb-1">Chef</p>
            <p class="text-ink font-medium">{brand.chef}</p>
          </div>
          <div>
            <p class="text-muted uppercase tracking-wider text-xs mb-1">Especialidad</p>
            <p class="text-ink font-medium">{brand.specialty}</p>
          </div>
          <div>
            <p class="text-muted uppercase tracking-wider text-xs mb-1">Desde</p>
            <p class="text-ink font-medium">{brand.yearFounded}</p>
          </div>
          <div>
            <p class="text-muted uppercase tracking-wider text-xs mb-1">Capacidad</p>
            <p class="text-ink font-medium">{brand.capacity.indoor} + {brand.capacity.terrace} terraza</p>
          </div>
        </div>
      </div>
      <div class="relative" data-reveal>
        <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-muted/10">
          <img
            src="/images/chef.svg"
            alt={`${brand.chef}, chef de ${brand.name}`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 bg-accent text-ink px-4 py-2 rounded-lg font-bold text-sm shadow-lg">
          Cocina de mar
        </div>
      </div>
    </div>
  </div>
</section>
