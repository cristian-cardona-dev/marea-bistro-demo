---
// src/components/About.astro
import { siteConfig } from '../config/site';

const { brand, content } = siteConfig;
---

<section class="py-24 px-6 bg-groundAlt/50" id="sobre-nosotros">
  <div class="max-w-5xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div data-reveal>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-ink mb-6">
          Sobre {brand.name}
        </h2>
        <p class="text-ink leading-relaxed mb-6">
          {content.aboutText}
        </p>
      </div>
    </div>
  </div>
</section>
