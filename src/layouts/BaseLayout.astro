---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { siteConfig } from '../config/site';

const { seo, theme, brand, images } = siteConfig;
const siteUrl = (seo.siteUrl || '').trim();
const hasSiteUrl = siteUrl.length > 0;

// Fontsource imports (self-hosted) — Newsreader display + DM Sans body
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/700.css';
import '@fontsource/newsreader/800.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.title, description = seo.description } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class={theme.mode === 'dark' ? 'dark' : ''} style={{
  '--site-ground': theme.colors.ground,
  '--site-ground-alt': theme.colors.groundAlt,
  '--site-ink': theme.colors.ink,
  '--site-accent': theme.colors.accent,
  '--site-secondary': theme.colors.secondary,
  '--site-muted': theme.colors.muted,
  '--site-font-display': theme.fonts.display,
  '--site-font-body': theme.fonts.body,
}}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    {hasSiteUrl && <link rel="canonical" href={siteUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasSiteUrl && <meta property="og:image" content={`${siteUrl}${images.ogImage}`} />}
    {hasSiteUrl && <meta property="og:url" content={siteUrl} />}
    <meta property="og:site_name" content={brand.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {hasSiteUrl && <meta name="twitter:image" content={`${siteUrl}${images.ogImage}`} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme color -->
    <meta name="theme-color" content={theme.colors.ground} />

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <a href="#hero" class="skip-link">Saltar al contenido</a>

    <slot />

    <!-- Progressive motion layer — Phase 5: choreographed reveal stagger.
         [data-reveal] elements are grouped by ancestor <section> or
         <div data-reveal-container>; the stagger index restarts per group.
         transition-delay = min(index * var(--stagger-short), var(--stagger-max))
         (--stagger-short: 80ms, --stagger-max: 300ms), resolved in CSS from
         --reveal-index written by this script.
         Transition: opacity/transform var(--duration-slow) var(--ease-out-expo),
         opacity 0 → 1, translateY 24px → 0.
         No module import: content is visible unless this script runs and the
         browser supports IntersectionObserver, so a script failure cannot hide
         the page. Reduced motion keeps everything visible and static. -->
    <script is:inline>
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        try {
          root.classList.add('js');

          // Contenedores de reparto: el índice de stagger se reinicia en cada
          // <section> o <div data-reveal-container>.
          const containers = Array.from(
            document.querySelectorAll('section, div[data-reveal-container]')
          );

          const assignIndex = (els) => {
            els.forEach((el, index) => {
              el.style.setProperty('--reveal-index', String(index));
            });
          };

          containers.forEach((container) => {
            assignIndex(Array.from(container.querySelectorAll('[data-reveal]')));
          });

          // Los [data-reveal] fuera de cualquier contenedor forman un grupo
          // en <body> (orden de documento), p. ej. las propias <section>.
          const orphans = Array.from(document.querySelectorAll('[data-reveal]')).filter(
            (el) => !containers.some((c) => c !== el && c.contains(el))
          );
          assignIndex(orphans);

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
          );

          const revealElements = document.querySelectorAll('[data-reveal]');
          revealElements.forEach((el) => observer.observe(el));

          // Reveal elements already in viewport on initial load.
          // Defer to next microtask so browser computes intersections first.
          queueMicrotask(() => {
            const initialEntries = observer.takeRecords();
            initialEntries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            });
          });
        } catch {
          // If anything above is unsupported or throws, keep every element visible.
          root.classList.remove('js');
        }
      }
    </script>

    <!-- Navigation scroll state (Phase 4): toggles .scrolled on #main-nav past 100px
         (rAF-throttled, passive listener). Inline, <500 bytes. -->
    <script>
      (function() {
        const nav = document.getElementById('main-nav');
        if (!nav) return;
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(() => { nav.classList.toggle('scrolled', window.scrollY > 100); ticking = false; }); ticking = true; }
        }, { passive: true });
      })();
    </script>

    <!-- Image load fade — Phase 5: images start at opacity: 0 and fade in
         once loaded (transition: opacity 200ms ease-out, defined in
         global.css). Cached/complete images are marked synchronously; the
         rest are marked on their load event. MutationObserver catches
         images added after initial render (SSR hydration, dynamic components).
         Error handler ensures broken images don't stay invisible. -->
    <script is:inline>
      function markLoaded(img) {
        img.classList.add('loaded');
      }
      function handleImg(img) {
        if (img.complete) { markLoaded(img); return; }
        img.addEventListener('load', () => markLoaded(img), { once: true });
        img.addEventListener('error', () => markLoaded(img), { once: true });
      }
      document.querySelectorAll('img[loading="lazy"]:not(.loaded)').forEach(handleImg);
      new MutationObserver((mutations) => {
        for (const m of mutations) {
          for (const node of m.addedNodes) {
            if (node.nodeType === 1) {
              const el = node;
              if (el.matches('img[loading="lazy"]')) handleImg(el);
              el.querySelectorAll?.('img[loading="lazy"]').forEach(handleImg);
            }
          }
        }
      }).observe(document.body, { subtree: true, childList: true });
    </script>
  </body>
</html>
